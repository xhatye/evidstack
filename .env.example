# Firebase browser configuration (public identifiers, not Admin credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server only. Store sensitive values in Vercel; never commit them.
# Rotate credentials previously committed, including those in git history.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GROQ_API_KEY=
# Current Groq model. openai/gpt-oss-120b is available on the free plan.
# Lower-cost production model. A retired/unknown GROQ_MODEL is ignored at runtime.
GROQ_MODEL=openai/gpt-oss-20b
# Server-side safety caps for all AI endpoints.
AI_PRO_DAILY_LIMIT=20
AI_PRO_MONTHLY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=10
AI_GLOBAL_MONTHLY_LIMIT=100
AI_BURST_LIMIT=4
RESEND_API_KEY=
CRON_SECRET=
APP_URL=https://evidstack.com

